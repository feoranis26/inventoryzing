POSTGRES_PASSWORD=replace-with-a-local-random-password
IZ_RUNTIME_PASSWORD=replace-with-a-different-random-password
IZ_DB_PORT=55438
IZ_HTTP_PORT=8088
# Bind the coordinator to a Tailnet IP for kiosk access, or 0.0.0.0 for all interfaces.
IZ_BIND_ADDRESS=127.0.0.1
# Set these to the address the kiosk uses to reach this coordinator.
IZ_PUBLIC_ORIGIN=http://localhost:8088
IZ_ALLOWED_HOSTS=["localhost","127.0.0.1","coordinator","*"]
